{
  "name": "archlast-cine",
  "version": "0.2.0",
  "private": true,
  "description": "Archlast Cine — self-hosted streaming platform (Turborepo monorepo): Next.js web app, NestJS account API, Rust media gateway and anime resolver sidecar.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "crates/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace @archlast/web",
    "test": "turbo run test",
    "test:coverage": "npm run test:coverage --workspace @archlast/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d db redis"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
