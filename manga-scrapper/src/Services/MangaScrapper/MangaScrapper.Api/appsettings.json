{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "OtlpEndpoint": "",
    "UsePrometheus": true,
    "AspireDashboard": {
      "Enabled": false,
      "Endpoint": "http://localhost:18889",
      "Protocol": "Grpc"
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "MangaScrapper"
  },
  "Scrapper": {
    "MaxParallelDownloads": 5,
    "ImageStoragePath": "images"
  },
  "FlareSolverr": {
    "Enabled": true,
    "Host": "http://localhost:8191"
  },
  "Meili": {
    "Host": "http://localhost:7700",
    "MasterKey": "mangas"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6333,
    "ApiKey": ""
  },
  "Embedding": {
    "Host": "http://localhost:8222",
    "ModelPath": "models/qwen3-embedding-0.6b/model.onnx",
    "TokenizerPath": "models/qwen3-embedding-0.6b/tokenizer.json",
    "VectorSize": 1024,
    "ExecutionProvider": "CPU"
  },
  "Discord": {
    "WebhookUrl": ""
  },
  "Domain": {
    "DomainUrl": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000" ]
  },
  "JwtSigningKey": "a_very_secret_key_that_is_at_least_32_chars_long!!",
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest",
      "PrefetchCount": 5
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "Default": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "MangaView": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "SemanticSearch": {
      "PermitLimit": 15,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "VectorSearch": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "Scraping": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "ImageProxy": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    }
  }
}
