@using NovaStack.Contracts.Responses
@inject HttpClient Http

@if (User != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-4xl max-h-[95vh] overflow-hidden flex flex-col border border-border-main animate-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="px-4 sm:px-6 py-4 border-b border-border-main flex items-center justify-between bg-surface shadow-sm z-10 flex-shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="h-10 w-10 rounded-xl bg-primary/10 text-primary font-black flex items-center justify-center text-base border border-primary/20 flex-shrink-0">
                        @(string.IsNullOrWhiteSpace(User.Username) ? "U" : User.Username[0].ToString().ToUpper())
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <h2 class="text-base sm:text-lg font-bold text-text-main truncate">@User.Username</h2>
                            @if (IsOnlineRecently(User.LastActiveAt))
                            {
                                <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Online
                                </span>
                            }
                        </div>
                        <p class="text-xs text-slate-400 truncate">ID: @User.UserId</p>
                    </div>
                </div>

                <button type="button" @onclick="Close" class="p-2 hover:bg-bg-app rounded-full transition-colors text-slate-400 hover:text-text-main cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Tab Navigation Bar -->
            <div class="px-4 sm:px-6 border-b border-border-main bg-bg-app flex items-center gap-2 overflow-x-auto flex-shrink-0 z-10">
                <button type="button" @onclick='() => SwitchTab("library")' class="py-3 px-3 text-xs font-bold border-b-2 transition-all flex items-center gap-1.5 flex-shrink-0 cursor-pointer @(_activeTab == "library" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-text-main")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span>User Library (@(_userLibraryData?.TotalCount ?? 0))</span>
                </button>

                <button type="button" @onclick='() => SwitchTab("progression")' class="py-3 px-3 text-xs font-bold border-b-2 transition-all flex items-center gap-1.5 flex-shrink-0 cursor-pointer @(_activeTab == "progression" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-text-main")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                    <span>Reading Progression (@(_userProgressions?.Count ?? 0))</span>
                </button>

                <button type="button" @onclick='() => SwitchTab("info")' class="py-3 px-3 text-xs font-bold border-b-2 transition-all flex items-center gap-1.5 flex-shrink-0 cursor-pointer @(_activeTab == "info" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-text-main")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span>Account Profile</span>
                </button>
            </div>

            <!-- Modal Content Body -->
            <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-6 bg-bg-app">
                
                @switch (_activeTab)
                {
                    case "library":
                    {
                        <div class="space-y-4">
                            <!-- Filters & Search Bar -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface p-3 rounded-xl border border-border-main">
                                <div class="relative flex-grow max-w-sm">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </span>
                                    <input type="text" @bind="_librarySearch" @bind:event="oninput" @onkeyup="HandleLibrarySearchKeyUp"
                                           placeholder="Filter by title..."
                                           class="w-full pl-9 pr-3 py-1.5 bg-bg-app border border-border-main rounded-lg text-xs text-text-main focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" />
                                </div>

                                <div class="flex items-center gap-2">
                                    <select @bind="_libraryStatusFilter" @bind:after="OnLibraryFilterChanged" class="px-2.5 py-1.5 bg-bg-app border border-border-main rounded-lg text-xs text-text-main outline-none focus:border-primary">
                                        <option value="">All Statuses</option>
                                        <option value="Reading">Reading</option>
                                        <option value="Completed">Completed</option>
                                        <option value="PlanToRead">Plan to Read</option>
                                        <option value="Dropped">Dropped</option>
                                        <option value="OnHold">On Hold</option>
                                    </select>

                                    <select @bind="_libraryPageSize" @bind:after="OnLibraryFilterChanged" class="px-2 py-1.5 bg-bg-app border border-border-main rounded-lg text-xs text-text-main outline-none focus:border-primary">
                                        <option value="8">8 / page</option>
                                        <option value="12">12 / page</option>
                                        <option value="20">20 / page</option>
                                    </select>
                                </div>
                            </div>

                            @if (_isLibraryLoading)
                            {
                                <div class="flex items-center justify-center py-12">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                                </div>
                            }
                            else if (_userLibraryData == null || !_userLibraryData.Items.Any())
                            {
                                <div class="bg-surface rounded-xl p-8 border border-border-main text-center">
                                    <div class="w-10 h-10 mx-auto mb-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                    </div>
                                    <p class="text-xs font-semibold text-text-main">No manga in this user's library</p>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">No library entries matched your search or status filter.</p>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var item in _userLibraryData.Items)
                                    {
                                        <div class="bg-surface p-3 rounded-xl border border-border-main flex gap-3 items-center hover:border-primary/30 transition-all">
                                            <div class="w-12 h-16 rounded-lg bg-slate-200 dark:bg-slate-800 overflow-hidden flex-shrink-0 border border-border-main">
                                                @if (!string.IsNullOrEmpty(item.Manga?.LocalImageUrl))
                                                {
                                                    <img src="/images/@item.Manga.LocalImageUrl" alt="" class="w-full h-full object-cover" />
                                                }
                                                else if (!string.IsNullOrEmpty(item.Manga?.ImageUrl))
                                                {
                                                    <img src="@item.Manga.ImageUrl" alt="" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center text-slate-400 text-[10px]">No Cover</div>
                                                }
                                            </div>
                                            <div class="min-w-0 flex-grow">
                                                <div class="flex items-center gap-1.5">
                                                    <h4 class="text-xs font-bold text-text-main truncate">@(item.Manga?.Title ?? "Manga #" + item.MangaId)</h4>
                                                    @if (item.IsFavorite == true)
                                                    {
                                                        <span class="text-amber-400 text-xs">★</span>
                                                    }
                                                </div>
                                                <p class="text-[10px] text-slate-400 truncate">@(item.Manga?.Author ?? "Unknown Author")</p>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-primary/10 text-primary">
                                                        @(string.IsNullOrEmpty(item.Status) ? "Saved" : item.Status)
                                                    </span>
                                                    <span class="text-[10px] text-slate-400">Added: @item.AddedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Library Pagination Bar -->
                                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-border-main/50">
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 text-center sm:text-left">
                                        Showing <span class="font-bold text-text-main">@((_libraryPage - 1) * _libraryPageSize + 1)</span> to 
                                        <span class="font-bold text-text-main">@(Math.Min(_libraryPage * _libraryPageSize, _userLibraryData.TotalCount))</span> of 
                                        <span class="font-bold text-text-main">@_userLibraryData.TotalCount</span> manga
                                    </p>

                                    <div class="flex items-center gap-2">
                                        <button type="button" @onclick="PreviousLibraryPage" disabled="@(!_userLibraryData.HasPreviousPage)" class="px-3 py-1 bg-surface hover:bg-bg-app border border-border-main rounded-lg text-xs font-semibold text-text-main disabled:opacity-40 transition-all cursor-pointer">
                                            Previous
                                        </button>
                                        <span class="text-xs font-bold px-2 text-text-main">Page @_libraryPage of @_userLibraryData.TotalPages</span>
                                        <button type="button" @onclick="NextLibraryPage" disabled="@(!_userLibraryData.HasNextPage)" class="px-3 py-1 bg-surface hover:bg-bg-app border border-border-main rounded-lg text-xs font-semibold text-text-main disabled:opacity-40 transition-all cursor-pointer">
                                            Next
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                        break;
                    }

                    case "progression":
                    {
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-sm font-bold text-text-main">Reading History & Progress</h3>
                            </div>

                            @if (_isProgressionLoading)
                            {
                                <div class="flex items-center justify-center py-12">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                                </div>
                            }
                            else if (_userProgressions == null || !_userProgressions.Any())
                            {
                                <div class="bg-surface rounded-xl p-8 border border-border-main text-center">
                                    <p class="text-xs text-slate-500 dark:text-slate-400">No reading activity recorded for this user yet.</p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    @foreach (var prog in _userProgressions)
                                    {
                                        <div class="bg-surface rounded-xl border border-border-main p-4 space-y-3">
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                                <div class="flex items-center gap-3 min-w-0">
                                                    <div class="w-12 h-16 rounded-lg bg-slate-200 dark:bg-slate-800 overflow-hidden flex-shrink-0 border border-border-main">
                                                        @if (!string.IsNullOrEmpty(prog.Manga?.LocalImageUrl))
                                                        {
                                                            <img src="/images/@prog.Manga.LocalImageUrl" alt="" class="w-full h-full object-cover" />
                                                        }
                                                        else if (!string.IsNullOrEmpty(prog.Manga?.ImageUrl))
                                                        {
                                                            <img src="@prog.Manga.ImageUrl" alt="" class="w-full h-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-full h-full flex items-center justify-center text-slate-400 text-[10px]">No Cover</div>
                                                        }
                                                    </div>

                                                    <div class="min-w-0">
                                                        <h4 class="text-xs font-bold text-text-main truncate">@(prog.Manga?.Title ?? "Manga #" + prog.MangaId)</h4>
                                                        <p class="text-[10px] text-slate-400 truncate">@(prog.Manga?.Author ?? "Unknown Author")</p>
                                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                                                            Last Read: <span class="font-semibold text-text-main">@prog.LastReadAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-3 flex-shrink-0">
                                                    <div class="text-left sm:text-right">
                                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Total Reading Time</span>
                                                        <span class="text-xs font-bold text-text-main">@FormatDurationSeconds(prog.TotalReadingTime)</span>
                                                    </div>
                                                    <div class="text-left sm:text-right">
                                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Chapters Read</span>
                                                        <span class="text-xs font-bold text-text-main">@(prog.ChapterLogs?.Count ?? 0)</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (prog.ChapterLogs != null && prog.ChapterLogs.Any())
                                            {
                                                <div class="bg-bg-app rounded-xl p-2.5 border border-border-main/50 space-y-1.5 max-h-48 overflow-y-auto">
                                                    <div class="grid grid-cols-4 text-[10px] font-bold text-slate-400 px-2 py-1 uppercase tracking-wider">
                                                        <span>Chapter</span>
                                                        <span>Page Progress</span>
                                                        <span>Status</span>
                                                        <span class="text-right">Time Spent</span>
                                                    </div>
                                                    @foreach (var cl in prog.ChapterLogs.OrderByDescending(c => c.ChapterNumber))
                                                    {
                                                        <div class="grid grid-cols-4 items-center text-xs px-2 py-1.5 rounded-lg hover:bg-surface/50 transition-colors">
                                                            <span class="font-bold text-text-main">Ch. @cl.ChapterNumber</span>
                                                            <span class="text-slate-500 dark:text-slate-400">@cl.LastReadPage / @(cl.TotalPage > 0 ? cl.TotalPage : "—")</span>
                                                            <div>
                                                                @if (cl.IsCompleted)
                                                                {
                                                                    <span class="px-1.5 py-0.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold rounded">Completed</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="px-1.5 py-0.5 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[10px] font-bold rounded">Reading</span>
                                                                }
                                                            </div>
                                                            <span class="text-right font-medium text-slate-600 dark:text-slate-300">@FormatDurationSeconds(cl.ReadTimeInSeconds)</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        break;
                    }

                    case "info":
                    {
                        <div class="bg-surface rounded-2xl p-5 border border-border-main space-y-4">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">User Account Information</h3>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">User ID</span>
                                    <p class="font-mono text-text-main font-bold break-all">@User.UserId</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Username</span>
                                    <p class="text-text-main font-bold">@User.Username</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Email Address</span>
                                    <p class="text-text-main font-bold">@User.Email</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Firebase Linked UID</span>
                                    <p class="font-mono text-text-main font-medium break-all">@(string.IsNullOrWhiteSpace(User.FirebaseUid) ? "Not Linked" : User.FirebaseUid)</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Account Status</span>
                                    <p class="font-bold @(User.IsActive ? "text-emerald-500" : "text-rose-500")">
                                        @(User.IsActive ? "Active" : "Disabled")
                                    </p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Last Active Heartbeat</span>
                                    <p class="font-bold text-text-main">
                                        @(User.LastActiveAt.HasValue ? User.LastActiveAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "Never Active")
                                    </p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Last IP Address</span>
                                    <p class="font-mono text-text-main font-bold break-all">@(string.IsNullOrWhiteSpace(User.ClientIpAddress) ? "Unknown" : User.ClientIpAddress)</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Registration Date</span>
                                    <p class="font-bold text-text-main">@User.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</p>
                                </div>

                                <div class="p-3 bg-bg-app rounded-xl border border-border-main/50">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Security Roles</span>
                                    <div class="flex flex-wrap gap-1 mt-1">
                                        @if (User.Roles != null && User.Roles.Any())
                                        {
                                            @foreach (var role in User.Roles)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetRoleClass(role)">@role</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        break;
                    }
                }

            </div>

            <!-- Modal Footer -->
            <div class="p-4 border-t border-border-main bg-surface flex justify-end flex-shrink-0">
                <button type="button" @onclick="Close" class="px-5 py-2 bg-surface hover:bg-bg-app border border-border-main rounded-xl text-xs font-semibold text-text-main transition-all cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public UserResponse? User { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string _activeTab = "library";

    // User Library Tab State
    private PagedResponse<UserLibraryResponse>? _userLibraryData;
    private bool _isLibraryLoading = false;
    private string? _libraryStatusFilter = "";
    private string? _librarySearch = "";
    private int _libraryPage = 1;
    private int _libraryPageSize = 12;

    // Reading Progression Tab State
    private List<UserProgressionResponse>? _userProgressions;
    private bool _isProgressionLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            _libraryPage = 1;
            _librarySearch = "";
            _libraryStatusFilter = "";
            await Task.WhenAll(LoadUserLibrary(), LoadUserProgression());
        }
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
    }

    private async Task Close()
    {
        _userLibraryData = null;
        _userProgressions = null;
        await OnClose.InvokeAsync();
    }

    private async Task LoadUserLibrary()
    {
        if (User == null) return;
        _isLibraryLoading = true;
        try
        {
            var url = $"api/v1/user-library?userId={User.UserId}&page={_libraryPage}&pageSize={_libraryPageSize}";
            if (!string.IsNullOrWhiteSpace(_libraryStatusFilter))
            {
                url += $"&status={Uri.EscapeDataString(_libraryStatusFilter)}";
            }
            if (!string.IsNullOrWhiteSpace(_librarySearch))
            {
                url += $"&search={Uri.EscapeDataString(_librarySearch.Trim())}";
            }

            var res = await Http.GetFromJsonAsync<ApiResponse<PagedResponse<UserLibraryResponse>>>(url);
            _userLibraryData = res?.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UserDetailModal] Error loading library: {ex.Message}");
        }
        finally
        {
            _isLibraryLoading = false;
        }
    }

    private async Task OnLibraryFilterChanged()
    {
        _libraryPage = 1;
        await LoadUserLibrary();
    }

    private async Task HandleLibrarySearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _libraryPage = 1;
            await LoadUserLibrary();
        }
    }

    private async Task PreviousLibraryPage()
    {
        if (_userLibraryData?.HasPreviousPage == true)
        {
            _libraryPage--;
            await LoadUserLibrary();
        }
    }

    private async Task NextLibraryPage()
    {
        if (_userLibraryData?.HasNextPage == true)
        {
            _libraryPage++;
            await LoadUserLibrary();
        }
    }

    private async Task LoadUserProgression()
    {
        if (User == null) return;
        _isProgressionLoading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<List<UserProgressionResponse>>>($"api/v1/user-progression/{User.UserId}");
            _userProgressions = res?.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UserDetailModal] Error loading progression: {ex.Message}");
        }
        finally
        {
            _isProgressionLoading = false;
        }
    }

    private static bool IsOnlineRecently(DateTime? lastActiveAt)
    {
        if (!lastActiveAt.HasValue) return false;
        return (DateTime.UtcNow - lastActiveAt.Value).TotalMinutes <= 5;
    }

    private static string FormatDurationSeconds(int totalSeconds)
    {
        if (totalSeconds <= 0) return "0s";
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalHours >= 1)
            return $"{(int)span.TotalHours}h {span.Minutes}m";
        if (span.TotalMinutes >= 1)
            return $"{span.Minutes}m {span.Seconds}s";
        return $"{span.Seconds}s";
    }

    private static string GetRoleClass(string role) => role switch
    {
        "SuperUser" => "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20",
        "Admin" => "bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20",
        _ => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20"
    };
}
