<div class="group bg-surface rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 border border-border-main overflow-hidden flex flex-col h-full cursor-pointer"
     @onclick="() => OnDetailClick.InvokeAsync(Manga)">
    <div class="relative aspect-[3/4] overflow-hidden">
        @if (Manga != null && !string.IsNullOrEmpty(Manga.LocalImageUrl))
        {
            <img src="/images/@Manga.LocalImageUrl" alt="@Manga.Title" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500" />
        }
        else if (Manga != null && !string.IsNullOrEmpty(Manga.ImageUrl))
        {
            <img src="@Manga.ImageUrl" alt="@Manga.Title" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500" />
        }
        
        <!-- Desktop Hover View Details Overlay -->
        <div class="hidden sm:flex absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 items-end justify-center p-3 sm:p-4">
            <button @onclick="() => OnDetailClick.InvokeAsync(Manga)" @onclick:stopPropagation="true" class="w-full py-2 bg-primary hover:bg-primary/90 text-white rounded-lg font-medium text-xs sm:text-sm transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 shadow-lg">
                View Details
            </button>
        </div>
        
        <div class="absolute top-2 sm:top-3 left-2 sm:left-3 flex flex-wrap gap-1">
            @if (!string.IsNullOrEmpty(Manga?.Type))
            {
                <span class="px-1.5 sm:px-2 py-0.5 sm:py-1 bg-surface/90 backdrop-blur-sm text-secondary dark:text-text-main text-[9px] sm:text-[10px] font-bold uppercase tracking-wider rounded shadow-sm border border-border-main/50">@Manga?.Type</span>
            }
            @if (Manga != null && Manga.Rating.HasValue)
            {
                <span class="px-1.5 sm:px-2 py-0.5 sm:py-1 bg-yellow-400 text-white text-[9px] sm:text-[10px] font-bold rounded shadow-sm flex items-center gap-0.5">
                    <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    @Manga.Rating.Value.ToString("F1")
                </span>
            }
        </div>
    </div>

    <div class="p-2.5 sm:p-4 flex flex-col flex-grow">
        <h3 class="text-xs sm:text-base font-bold text-text-main line-clamp-2 leading-tight mb-1 group-hover:text-primary transition-colors" title="@Manga?.Title">
            @Manga?.Title
        </h3>
        <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium truncate mb-2 sm:mb-3">@(string.IsNullOrWhiteSpace(Manga?.Author) ? "Unknown" : Manga?.Author)</p>
        
        <div class="mt-auto">
            @if (Manga?.LatestChapter != null)
            {
                <div class="flex items-center justify-between pt-2 sm:pt-3 border-t border-border-main/50">
                    <span class="text-[10px] sm:text-[11px] font-bold text-slate-400">Ch. @Manga.LatestChapter.Number</span>
                    <span class="text-[9px] sm:text-[10px] text-slate-400">@Manga.LatestChapter.UploadDate.ToLocalTime().ToString("MMM dd")</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public MangaSummary Manga { get; set; } = default!;

    [Parameter]
    public EventCallback<MangaSummary> OnDetailClick { get; set; }
}
