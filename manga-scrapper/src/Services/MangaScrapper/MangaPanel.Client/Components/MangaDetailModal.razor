    private async Task HandleLocalThumbnailSelected(InputFileChangeEventArgs e)
    {
        _selectedUploadFile = e.File;
        _thumbnailErrorMessage = null;

        if (_selectedUploadFile != null)
        {
            try
            {
                var maxAllowedSize = 10 * 1024 * 1024; // 10MB
                if (_selectedUploadFile.Size > maxAllowedSize)
                {
                    _thumbnailErrorMessage = "File size exceeds maximum limit of 10MB.";
                    _selectedUploadFile = null;
                    return;
                }

                var buffer = new byte[_selectedUploadFile.Size];
                await using var stream = _selectedUploadFile.OpenReadStream(maxAllowedSize);
                await stream.ReadExactlyAsync(buffer);
                _localPreviewDataUrl = $"data:{_selectedUploadFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
            }
            catch (Exception ex)
            {
                _thumbnailErrorMessage = $"Failed to read file: {ex.Message}";
            }
        }
    }

    private async Task SaveThumbnailAsync()
    {
        _isUpdatingThumbnail = true;
        _thumbnailErrorMessage = null;
        StateHasChanged();

        try
        {
            if (_thumbnailSourceTab == 0 && _selectedUploadFile != null)
            {
                using var content = new MultipartFormDataContent();
                var maxAllowedSize = 10 * 1024 * 1024;
                var fileStream = _selectedUploadFile.OpenReadStream(maxAllowedSize);
                var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_selectedUploadFile.ContentType);
                content.Add(streamContent, "file", _selectedUploadFile.Name);

                var response = await Http.PostAsync($"/api/v1/manga/{MangaId}/thumbnail/upload", content);
                if (response.IsSuccessStatusCode)
                {
                    var updated = await Http.GetApiDataAsync<MangaSummary>($"/api/v1/manga/{MangaId}");
                    if (updated != null) Manga = updated;
                    _isChangeThumbnailOpen = false;
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    var errorMsg = await response.Content.ReadAsStringAsync();
                    _thumbnailErrorMessage = $"Upload failed: {errorMsg}";
                }
            }
            else if (_thumbnailSourceTab == 1 && !string.IsNullOrWhiteSpace(_customThumbnailUrl))
            {
                var payload = new { ImageUrl = _customThumbnailUrl.Trim() };
                var response = await Http.PatchAsJsonAsync($"/api/v1/manga/{MangaId}/thumbnail", payload);
                if (response.IsSuccessStatusCode)
                {
                    var updated = await Http.GetApiDataAsync<MangaSummary>($"/api/v1/manga/{MangaId}");
                    if (updated != null) Manga = updated;
                    _isChangeThumbnailOpen = false;
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    var errorMsg = await response.Content.ReadAsStringAsync();
                    _thumbnailErrorMessage = $"Update failed: {errorMsg}";
                }
            }
        }
        catch (Exception ex)
        {
            _thumbnailErrorMessage = $"Error updating thumbnail: {ex.Message}";
        }
        finally
        {
            _isUpdatingThumbnail = false;
            StateHasChanged();
        }
    }

