        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/v1/manga/{MangaId}/chapter/{chapter.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Chapters.Remove(chapter);
                    _selectedChapterIds.Remove(chapter.Id);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting chapter: {ex.Message}");
            }
        }
    }

