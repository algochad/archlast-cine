                                                }
                                                else
                                                {
                                                    @(chPage.Width > 0 && chPage.Height > 0 ? $"{chPage.Width}×{chPage.Height}" : "WebP")
                                                }
                                            </span>
                                            @if (!string.IsNullOrEmpty(chPage.Url))
                                            {
                                                <a href="/images/@chPage.Url" target="_blank" class="text-primary hover:underline" title="Open original">View ↗</a>
                                            }
                                            else if (!string.IsNullOrEmpty(chPage.AlternateUrl))
                                            {
                                                <a href="@chPage.AlternateUrl" target="_blank" class="text-primary hover:underline" title="Open remote">View ↗</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Modal Footer -->
                    <div class="px-5 sm:px-6 py-3 border-t border-border-main flex items-center justify-between bg-surface">
                        <span class="text-xs text-slate-400">Total: @(_inspectingChapter.Pages?.Count ?? _inspectingChapter.TotalPages) pages</span>
                        <button @onclick="CloseInspectChapterModal" class="px-4 py-1.5 bg-bg-app hover:bg-slate-200 dark:hover:bg-slate-800 text-text-main font-bold text-xs rounded-xl transition-all">
                            Close
                        </button>
                    </div>
                </div>
            </div>

            <!-- Fullscreen Lightbox Overlay -->
            @if (_inspectingChapter.Pages != null && _lightboxPageIndex >= 0 && _lightboxPageIndex < _inspectingChapter.Pages.Count)
            {
                var currentPage = _inspectingChapter.Pages[_lightboxPageIndex];
                <div class="fixed inset-0 z-[240] flex flex-col items-center justify-center p-2 sm:p-4 bg-slate-950/90 backdrop-blur-md" @onclick="CloseLightbox">
                    <div class="absolute top-4 right-4 z-50 flex items-center gap-3" @onclick:stopPropagation="true">
                        <span class="px-3 py-1 bg-slate-800/80 text-white text-xs font-bold rounded-full">
                            Page @(_lightboxPageIndex + 1) of @_inspectingChapter.Pages.Count
                        </span>
                        <button @onclick="CloseLightbox" class="p-2 bg-slate-800 hover:bg-slate-700 text-white rounded-full transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>

                    <div class="relative max-w-full max-h-[85vh] flex items-center justify-center" @onclick:stopPropagation="true">
                        @if (_lightboxPageIndex > 0)
                        {
                            <button @onclick="PrevLightboxPage" class="absolute left-2 sm:-left-12 p-3 bg-slate-800/80 hover:bg-slate-700 text-white rounded-full transition-all shadow-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                        }

                        @if (!string.IsNullOrEmpty(currentPage.Url))
                        {
                            <img src="/images/@currentPage.Url" class="max-h-[80vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" alt="Page @(_lightboxPageIndex + 1)" />
                        }
                        else if (!string.IsNullOrEmpty(currentPage.AlternateUrl))
                        {
                            <img src="@currentPage.AlternateUrl" class="max-h-[80vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" alt="Page @(_lightboxPageIndex + 1)" />
                        }

                        @if (_lightboxPageIndex < _inspectingChapter.Pages.Count - 1)
                        {
                            <button @onclick="NextLightboxPage" class="absolute right-2 sm:-right-12 p-3 bg-slate-800/80 hover:bg-slate-700 text-white rounded-full transition-all shadow-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
@* End of modal *@


@code {
    [Parameter] public Guid MangaId { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private MangaSummary? Manga { get; set; }
    private UpdateModel EditModel { get; set; } = new();
    private List<ChapterResponse> Chapters { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; } = false;
    private bool _isClosing = false;
    private int _activeTab = 0;
    
    private HubConnection? _hubConnection;
    private Guid _currentJoinedMangaId;

    // Real-Time Scraping Progress State
    private bool _isScrapingActive = false;
    private double _scrapingChapterNumber = 0;
    private Guid _scrapingChapterId = Guid.Empty;
    private int _scrapingDownloadedPages = 0;
    private int _scrapingTotalPages = 0;
    private int _scrapingPercent = 0;
    private string _scrapingStatus = "InProgress";
    
    private bool _isSearchJikanOpen = false;
    private string _jikanSearchQuery = "";
    private List<MangaSummaryResponse> _jikanSearchResults = new();
    private bool _isSearchingJikan = false;

    private bool _isSearchAnilistOpen = false;
    private string _anilistSearchQuery = "";
    private List<MangaSummaryResponse> _anilistSearchResults = new();
    private bool _isSearchingAnilist = false;

    private bool _isSearchMangaUpdatesOpen = false;
    private string _mangaUpdatesSearchQuery = "";
    private List<MangaSummaryResponse> _mangaUpdatesSearchResults = new();
    private bool _isSearchingMangaUpdates = false;

    // Change Thumbnail State
    private bool _isChangeThumbnailOpen = false;
    private int _thumbnailSourceTab = 0; // 0 = Local File, 1 = Online URL
    private string _customThumbnailUrl = "";
    private string _localPreviewDataUrl = "";
    private IBrowserFile? _selectedUploadFile;
    private bool _isUpdatingThumbnail = false;
    private string? _thumbnailErrorMessage;

    // Bulk Delete Chapters State
    private HashSet<Guid> _selectedChapterIds = new();
    private bool _isDeletingBulkChapters = false;
    private bool IsAllChaptersSelected => Chapters.Count > 0 && _selectedChapterIds.Count == Chapters.Count;

    // Inspect Chapter State
    private bool _isInspectChapterOpen = false;
    private bool _isLoadingInspectPages = false;
    private ChapterResponse? _inspectingChapter;
    private int _lightboxPageIndex = -1;

    private string GenresString => EditModel.Genres != null ? string.Join(", ", EditModel.Genres) : "";
    private string CategoriesString => EditModel.Categories != null ? string.Join(", ", EditModel.Categories) : "";

    protected override async Task OnParametersSetAsync()
    {
        if (MangaId != Guid.Empty)
        {
            await LoadManga();
            await SetupSignalR();
        }
    }

    private async Task SetupSignalR()
    {
        try
        {
            if (_hubConnection == null)
            {
                _hubConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/hubs/manga"))
                    .WithAutomaticReconnect()
                    .Build();

                _hubConnection.On<System.Text.Json.JsonElement>("ChaptersUpdated", async (payload) =>
                {
                    if (MangaId != Guid.Empty)
                    {
                        var match = false;
                        if (payload.TryGetProperty("mangaId", out var mangaIdProp))
                        {
                            if (mangaIdProp.ValueKind == System.Text.Json.JsonValueKind.String &&
                                Guid.TryParse(mangaIdProp.GetString(), out var eventMangaId) &&
                                eventMangaId == MangaId)
                            {
                                match = true;
                            }
                        }

                        if (match)
                        {
                            await RefreshChapters();
                        }
                    }
                });

                _hubConnection.On<System.Text.Json.JsonElement>("ChapterScrapingProgress", async (payload) =>
                {
                    if (MangaId != Guid.Empty)
                    {
                        var match = false;
                        if (payload.TryGetProperty("mangaId", out var mangaIdProp))
                        {
                            if (mangaIdProp.ValueKind == System.Text.Json.JsonValueKind.String &&
                                Guid.TryParse(mangaIdProp.GetString(), out var eventMangaId) &&
                                eventMangaId == MangaId)
                            {
                                match = true;
                            }
                        }

                        if (match)
                        {
                            _isScrapingActive = true;
                            if (payload.TryGetProperty("chapterNumber", out var chProp)) _scrapingChapterNumber = chProp.GetDouble();
                            if (payload.TryGetProperty("chapterId", out var chIdProp) && Guid.TryParse(chIdProp.GetString(), out var chId)) _scrapingChapterId = chId;
                            if (payload.TryGetProperty("downloadedPages", out var dlProp)) _scrapingDownloadedPages = dlProp.GetInt32();
                            if (payload.TryGetProperty("totalPages", out var totalProp)) _scrapingTotalPages = totalProp.GetInt32();
                            if (payload.TryGetProperty("percent", out var pctProp)) _scrapingPercent = pctProp.GetInt32();
                            if (payload.TryGetProperty("status", out var statusProp)) _scrapingStatus = statusProp.GetString() ?? "InProgress";

                            if (_scrapingStatus == "Completed")
                            {
                                await RefreshChapters();
                                _ = Task.Run(async () =>
                                {
                                    await Task.Delay(4000);
                                    if (_scrapingStatus == "Completed" && _scrapingPercent >= 100)
                                    {
                                        _isScrapingActive = false;
                                        await InvokeAsync(StateHasChanged);
                                    }
                                });
                            }
                            else if (_scrapingStatus == "Failed")
                            {
                                _ = Task.Run(async () =>
                                {
                                    await Task.Delay(5000);
                                    _isScrapingActive = false;
                                    await InvokeAsync(StateHasChanged);
                                });
                            }

                            await InvokeAsync(StateHasChanged);
                        }
                    }
                });

                await _hubConnection.StartAsync();
            }

            if (_hubConnection.State == HubConnectionState.Connected)
            {
                if (_currentJoinedMangaId != Guid.Empty && _currentJoinedMangaId != MangaId)
                {
                    await _hubConnection.SendAsync("LeaveMangaGroup", _currentJoinedMangaId.ToString());
                }
                await _hubConnection.SendAsync("JoinMangaGroup", MangaId.ToString());
                _currentJoinedMangaId = MangaId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MangaDetailModal] SignalR error: {ex.Message}");
        }
    }

    private async Task RefreshChapters()
    {
        try
        {
