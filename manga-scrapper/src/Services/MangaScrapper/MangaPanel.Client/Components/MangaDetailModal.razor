    private async Task ConfirmBulkDeleteChapters()
    {
        if (!_selectedChapterIds.Any()) return;

        var count = _selectedChapterIds.Count;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {count} selected chapter(s) from storage and database?\n\nThis action cannot be undone.");
        if (!confirmed) return;

        _isDeletingBulkChapters = true;
        StateHasChanged();

        try
        {
            var idsToDelete = _selectedChapterIds.ToList();
            var deleteTasks = idsToDelete.Select(async chapterId =>
            {
                try
                {
                    var response = await Http.DeleteAsync($"/api/v1/manga/{MangaId}/chapter/{chapterId}");
                    return (ChapterId: chapterId, Success: response.IsSuccessStatusCode);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error deleting chapter {chapterId}: {ex.Message}");
                    return (ChapterId: chapterId, Success: false);
                }
            });

            var results = await Task.WhenAll(deleteTasks);
            var successfulIds = results.Where(r => r.Success).Select(r => r.ChapterId).ToHashSet();

            Chapters.RemoveAll(c => successfulIds.Contains(c.Id));
            _selectedChapterIds.RemoveWhere(id => successfulIds.Contains(id));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during bulk delete: {ex.Message}");
        }
        finally
        {
            _isDeletingBulkChapters = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteChapter(ChapterResponse chapter)
    {
