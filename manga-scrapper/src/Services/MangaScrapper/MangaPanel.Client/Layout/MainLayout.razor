@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 font-sans text-slate-900 w-full overflow-x-hidden">
    @Body
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:right-4 max-w-sm bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl shadow-lg z-50 text-sm">
    An unhandled error has occurred.
    <a href="." class="reload font-bold underline ml-2">Reload</a>
    <span class="dismiss cursor-pointer ml-2 float-right font-bold">✕</span>
</div>