# Local dev defaults for the compose infrastructure.
#
# This machine already runs PostgreSQL/Redis on the standard ports, so the
# compose services are published on 55432/56379 instead. Delete the two
# *_HOST_PORT lines (and DATABASE_URL/REDIS_URL) if 5432/6379 are free —
# `docker compose` and `npm run dev` both read this file.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
DATABASE_URL=postgres://moviebox:moviebox@127.0.0.1:55432/moviebox
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=dev-secret-moviebox
API_URL=http://127.0.0.1:4100
